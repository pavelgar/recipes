{
  "name": "recipes",
  "private": true,
  "license": "AGPL-3.0-only",
  "type": "module",
  "engines": {
    "node": ">=24"
  },
  "scripts": {
    "dev": "vite dev --port 3000",
    "build": "vite build",
    "start": "node .output/server/index.mjs",
    "preview": "vite preview",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:e2e": "playwright test -c tests/e2e",
    "ledger:sample": "node scripts/ledger-sample.ts",
    "lint": "eslint",
    "typecheck": "tsc --noEmit && tsc --noEmit -p src/service-worker",
    "format": "prettier --write . && eslint --fix",
    "check": "prettier --check .",
    "icons": "pwa-assets-generator --config scripts/pwa-assets.config.ts",
    "db:generate": "drizzle-kit generate --config src/server/db/drizzle.config.ts",
    "db:migrate": "drizzle-kit migrate --config src/server/db/drizzle.config.ts",
    "db:push": "drizzle-kit push --config src/server/db/drizzle.config.ts",
    "db:pull": "drizzle-kit pull --config src/server/db/drizzle.config.ts",
    "db:studio": "drizzle-kit studio --config src/server/db/drizzle.config.ts"
  },
  "dependencies": {
