    "drizzle-orm": "^0.45.1",
    "es-toolkit": "^1.52.0",
    "minisearch": "^7.2.0",
    "nitro": "3.0.260610-beta",
    "pluralize": "^8.0.0",
    "react": "^19.2.0",
    "react-dom": "^19.2.0",
    "shadcn": "^4.22.1",
    "tailwindcss": "^4.1.18",
    "tw-animate-css": "^1.4.0",
    "zod": "^4.3.6"
